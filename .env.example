# Copy this file to .env and fill in the keys for whichever provider(s) you use.
# Only the key for your active provider needs to be set to run ShadowChat.
#
# ShadowChat auto-loads .env at startup (via python-dotenv) from the same
# directory as shadowchat.py, regardless of where you launch it from. A key
# already exported in your real shell environment always takes priority --
# .env only fills in whatever isn't already set, e.g.:
#   export GEMINI_API_KEY="your-key-here"

GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
